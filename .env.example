# =============================================================================
# MindScribe AI Journal - environment configuration
#
# Copy to `.env` for local development. `.env` is gitignored; never commit it.
# On Cloud Run, set GEMINI_API_KEY via Secret Manager and the rest via
# --set-env-vars / --build-arg (see README).
# =============================================================================

# --- Server-side secrets (never exposed to the browser) ----------------------

# Gemini API key. Store in Secret Manager in production.
GEMINI_API_KEY=

# Firebase project the backend verifies ID tokens against.
# Auto-populated on Cloud Run via GOOGLE_CLOUD_PROJECT; set explicitly locally.
FIREBASE_PROJECT_ID=

# Named Firestore database. Leave blank for "(default)".
FIRESTORE_DATABASE_ID=

# Comma-separated emails always treated as superadmin, e.g. you@example.com
ADMIN_EMAILS=

# Accept unsigned `demo-token-*` bearer tokens so evaluators can try the app
# without a Google account. MUST remain unset/false wherever real user data
# lives - it bypasses signature verification by design.
ALLOW_DEMO_MODE=false

# Optional: override the Gemini model fallback ladder (comma-separated, in order).
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# --- Client-side config (VITE_* is inlined into the browser bundle at BUILD
#     time; these are public identifiers, not secrets) -----------------------

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Leave blank for the "(default)" Firestore database.
VITE_FIRESTORE_DATABASE_ID=

# Google Maps browser key. Restrict by HTTP referrer and scope to
# Maps JavaScript API + Places API (New). Do NOT put the Gemini key here.
VITE_GOOGLE_MAPS_API_KEY=
