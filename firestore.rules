rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the caller is an administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['ajith.redrigo@yahoo.com', 'ajith.redrigo@gmail.com'] ||
        (exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in ['admin', 'superadmin'])
      );
    }

    // Helper function to check if caller is superadmin
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email in ['ajith.redrigo@yahoo.com', 'ajith.redrigo@gmail.com'] ||
        (exists(/databases/$(database)/documents/roles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'superadmin')
      );
    }

    // User-isolated collections: interactions, insights, actionItems, webhooks, settings
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
    }

    // Role-based Access Control (RBAC) collection
    match /roles/{userId} {
      // Any authenticated user can read their own role; Admins can read all user roles
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Users can bootstrap their own default role on sign up; Admins can create/assign roles
      allow create: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Users can update their own role (for switcher) and Admins can update any role
      allow update, delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Security & System Audit Logs
    match /audit_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isSuperAdmin();
    }
  }
}

